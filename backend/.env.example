APP_NAME=Whoosh Employee Seat Availability API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1

DATABASE_URL=mysql+pymysql://booking_user:booking_password@127.0.0.1:3306/booking_seat

# JSON array is supported by pydantic-settings for this field.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","https://your-github-username.github.io"]

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-development-password
SEED_ADMIN_NAME=Development Admin
